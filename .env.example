# Production Site URL (Optional, fallback defaults to https://antriksh.dev)
VITE_SITE_URL=https://antriksh.dev

# GitHub Public API User (Defaults to Antrikshcodes)
VITE_GITHUB_USER=Antrikshcodes

# Vercel Analytics / Telemetry (Optional)
# VITE_VERCEL_ANALYTICS_ID=

# ANTRIKSH AI Provider Configuration (Optional for Vercel deployment)
# Note: If no API key is set, ANTRIKSH AI automatically falls back to the
# built-in grounded knowledge engine with zero downtime or API costs.
# To connect a live remote LLM, set ONE of the following server-side environment variables in Vercel:
# OPENAI_API_KEY=sk-...         # OpenAI GPT-4o-mini (~$0.15/1M tokens)
# GROQ_API_KEY=gsk_...          # Groq LLaMA 3.3 70B (free tier available)
# OPENROUTER_API_KEY=sk-or-...  # OpenRouter meta-llama/llama-3.1-8b-instruct
